{
  "manifest_version": 3,
  "name": "מבחן המציאות",
  "version": "1.0",
  "description": "התוסף ששם את הנתונים מול העיניים: ניתוח חודשי של דפוסי השימוש באינטרנט, בצורה ברורה ונוחה.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting"
  ]
}