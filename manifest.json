{
  "manifest_version": 3,
  "name": "מחשבון הזמן",
  "version": "1.0",
  "description": "הצגת גרפים על השימוש באיטרנט.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting"
  ]
}